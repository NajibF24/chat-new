apiVersion: apps/v1
kind: Deployment
metadata:
  name: dms-app
  namespace: dms
spec:
  replicas: 1
  selector:
    matchLabels:
      app: client-app
  template:
    metadata:
      labels:
        app: dms-app
    spec:
      imagePullSecrets:
        - name:	client-registry   # secret untuk pull image dari Harbor
      containers:
        - name: php-fpm
          image: harbor.gyssteel.com/dms/fe-be:IMAGE_TAG
          ports:
            - containerPort: 80
          envFrom:
            - configMapRef:
                name: dms-config
            - secretRef:
                name: dms-secret
          resources:
            requests:
              cpu: "200m"
              memory: "256Mi"
            limits:
              cpu: "500m"
              memory: "512Mi"
